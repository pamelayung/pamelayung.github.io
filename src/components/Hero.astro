---
import { siteConfig } from "../config";
---

<section class="relative min-h-[90vh] flex items-center px-8 sm:px-12 md:px-16 lg:px-24 overflow-hidden bg-[#f8f8f8]">

  <!-- GRID BACKGROUND -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute inset-0 opacity-80"
      style="
        background-image:
          linear-gradient(to right, rgba(209,213,219,0.6) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(209,213,219,0.6) 1px, transparent 1px);
        background-size: 26rem 14rem;
      "
    ></div>

    <!-- FLOATING SYMBOLS -->
    <div class="absolute inset-0 font-mono text-5xl text-blue-100 select-none">

      <span class="absolute left-[8%] top-[10%] opacity-60">
        &lt;/&gt;
      </span>

      <span class="absolute left-[35%] top-[18%] opacity-40">
        =&gt;
      </span>

      <span class="absolute left-[63%] top-[9%] opacity-50">
        &lt;/&gt;
      </span>

      <span class="absolute right-[8%] top-[25%] opacity-40">
        &lt;
      </span>

      <span class="absolute left-[18%] top-[48%] opacity-30">
        {}
      </span>

      <span class="absolute left-[60%] top-[52%] opacity-40">
        []
      </span>

      <span class="absolute right-[14%] top-[58%] opacity-30">
        ()
      </span>

      <span class="absolute left-[10%] bottom-[10%] opacity-40">
        &lt;/&gt;
      </span>

      <span class="absolute left-[42%] bottom-[18%] opacity-30">
        ==
      </span>

      <span class="absolute right-[30%] bottom-[8%] opacity-40">
        &lt;/&gt;
      </span>

      <span class="absolute right-[10%] bottom-[20%] opacity-30">
        ==
      </span>

    </div>
  </div>

  <!-- HERO CONTENT -->
  <div class="relative z-10 max-w-6xl">

    <p class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-700 mb-6">
      Hello! 👋
    </p>

    <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold tracking-tight text-gray-900 leading-none">
      I'm
      <span
        class="ml-4"
        style={`color: ${siteConfig.accentColor}`}
      >
        {siteConfig.name}
      </span>
    </h1>

    <p class="mt-8 text-xl sm:text-2xl md:text-3xl text-gray-600 font-medium font-mono">
      {siteConfig.title}
    </p>

    <div class="flex gap-6 mt-16 text-gray-600 font-mono">
      <a
        href={`mailto:${siteConfig.social.email}`}
        target="_blank"
        aria-label="Email"
        class="hover:text-black transition"
      >
        Email
      </a>

      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        aria-label="LinkedIn"
        class="hover:text-black transition"
      >
        LinkedIn
      </a>

      <a
        href={siteConfig.social.github}
        target="_blank"
        aria-label="GitHub"
        class="hover:text-black transition"
      >
        GitHub
      </a>
    </div>

  </div>
</section>