---
import "../../styles/global.css";
import { siteConfig } from "../../config";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const accent = siteConfig.accentColor || "#1d4ed8";

const navItems = [
  ["Overview", "#overview"],
  ["Problem", "#problem"],
  ["Research", "#research"],
  ["Insights", "#insights"],
  ["User Flows", "#flows"],
  ["Prototype", "#prototype"],
  ["Testing", "#testing"],
  ["Before / After", "#before-after"],
  ["Reflection", "#reflection"],
];

const insights = [
  [
    "Quick access matters",
    "Users need balance, deposit, and spending information upfront.",
  ],
  [
    "Food planning is connected",
    "Grocery inventory and benefits planning should not feel separate.",
  ],
  [
    "Reminders reduce waste",
    "Expiration and quantity prompts help users use what they already have.",
  ],
];

const userFlows = [
  [
    "/images/propel/user-flow-1.png",
    "User Flow 1 maps how users move from checking benefit status to finding relevant support.",
  ],
  [
    "/images/propel/user-flow-2.png",
    "User Flow 2 maps how users discover grocery savings, inventory tools, and planning features.",
  ],
];

const prototypeScreens = [
  [
    "/images/propel/home-dashboard-phone.png",
    "Home dashboard",
    "Quick view of EBT balance, spending, deposit timeline, and grocery reminders.",
  ],
  [
    "/images/propel/spending-breakdown-phone.png",
    "Spending breakdown",
    "Shows remaining balance, recent spending, and top spending categories.",
  ],
  [
    "/images/propel/receipt-detail-phone.png",
    "Receipt detail",
    "Lets users review receipt-level details without leaving the spending breakdown.",
  ],
  [
    "/images/propel/inventory-overview-phone.png",
    "Inventory overview",
    "Helps users track grocery categories, food quantity, and items expiring soon.",
  ],
];

const findings = [
  [
    "The homepage needed to be more actionable.",
    "The original homepage emphasized offers, but the redesign made grocery reminders more visible so users could act on food expiration dates sooner.",
  ],
  [
    "Inventory needed stronger hierarchy.",
    "Users needed to quickly understand how many items they had, what categories they belonged to, and which foods were expiring soon.",
  ],
  [
    "Spending details needed context.",
    "The spending breakdown became clearer after adding recent transactions, category colors, and receipt actions.",
  ],
];

const beforeAfterStories = [
  [
    "/images/propel/before-after-home.png",
    "Before and after homepage redesign showing offers changed into grocery reminders",
    "From generic offers to grocery reminders",
    "The original homepage included EBT balance information and third-party offers, but those offers did not directly support the grocery planning problem we were solving. In the redesign, we replaced that area with grocery reminders so users could immediately see what food is expiring soon and decide whether to keep or remove items from inventory.",
  ],
  [
    "/images/propel/before-after-inventory.png",
    "Before and after inventory redesign showing bar chart changed into category cards",
    "From a bar chart to scannable inventory cards",
    "The earlier inventory screen used horizontal bar charts, which showed quantities but made the page feel more like a data visualization than a grocery tool. The updated version uses category cards, icons, and urgency labels so users can quickly understand their pantry, identify what expires today, and prioritize what to use next.",
  ],
  [
    "/images/propel/inventory-redesign-annotations.png",
    "Annotated inventory redesign decisions",
    "Making expiration information easier to act on",
    "We refined the inventory screen by adding a search bar, reorganizing categories into cards, and separating items into “expires today” and “expiring soon.” This made the screen easier to scan and helped users understand urgency without needing to interpret a chart.",
  ],
  [
    "/images/propel/spending-redesign-annotations.png",
    "Annotated spending breakdown redesign decisions",
    "Making spending history easier to understand",
    "The spending breakdown was revised to emphasize remaining balance, recent transactions, category colors, and receipt access. These changes make the screen more useful for users who want to understand where their benefits are going and how much they have left to spend.",
  ],
];
---

<html lang="en">
  <head>
    <title>Propel Case Study | Pamela Yung</title>
    <meta
      name="description"
      content="A UX case study redesigning Propel into a benefits and grocery planning tool."
    />
    <link rel="icon" type="image/svg+xml" href="/fruit-favicon.png" />
  </head>

  <body class="bg-[#f8fafc] text-gray-950">
    <Header />

    <main class="min-h-screen px-5 sm:px-8 lg:px-12 py-24">
      <div class="mx-auto max-w-7xl rounded-[2rem] border border-gray-200 bg-white shadow-sm overflow-hidden">
        <!-- HERO -->
        <section
          class="relative overflow-hidden border-b border-gray-200 px-6 sm:px-10 lg:px-14 py-20 lg:py-28"
          style={`--accent-color: ${accent}`}
        >
          <div
            class="absolute inset-0 opacity-80"
            style={`background: radial-gradient(ellipse 900px 600px at 0% 0%, ${accent}30 0%, ${accent}14 35%, transparent 70%)`}
          />

          <div class="relative z-10 max-w-5xl">
            <a
              href="/"
              class="inline-flex items-center gap-2 mb-12 font-mono text-sm text-gray-500 hover:text-gray-900 transition"
            >
              <span aria-hidden="true">&larr;</span>
              <span>Back to Home</span>
            </a>

            <p
              class="font-mono text-sm sm:text-base mb-6 tracking-wide"
              style={`color: ${accent}`}
            >
              UX CASE STUDY / PRODUCT DESIGN / FIGMA
            </p>

            <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[0.9] text-gray-950">
              Propel Benefits
              <br />
              <span style={`color: ${accent}`}>
                & Grocery Planning
              </span>
              <br />
              Redesign
            </h1>

            <p class="mt-8 max-w-3xl text-lg sm:text-xl font-mono leading-relaxed text-gray-600">
              I redesigned Propel into a benefits and grocery planning tool that helps users track EBT balance,
              monitor grocery inventory, reduce food waste, and make more informed spending decisions.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              {["Figma", "UX Research", "Product Design", "User Flows"].map((tag) => (
                <span class="rounded-full border border-gray-200 bg-white/80 px-4 py-2 font-mono text-xs text-gray-600 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-md">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr]">
          <!-- SIDEBAR -->
          <aside class="hidden lg:block border-r border-gray-200 bg-gray-50/70 px-6 py-10">
            <div class="sticky top-24">
              <p class="font-mono text-xs uppercase tracking-widest text-gray-400 mb-5">
                Case Study
              </p>

              <nav class="space-y-1">
                {navItems.map(([label, href]) => (
                  <a
                    href={href}
                    class="block rounded-xl px-4 py-3 font-mono text-sm text-gray-600 transition hover:bg-white hover:text-gray-950 hover:shadow-sm"
                  >
                    {label}
                  </a>
                ))}
              </nav>

              <div class="mt-10 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
                <p class="font-mono text-xs uppercase tracking-widest text-gray-400">
                  Role
                </p>
                <p class="mt-2 font-bold text-gray-950">
                  UX Designer
                </p>

                <p class="mt-5 font-mono text-xs uppercase tracking-widest text-gray-400">
                  Tools
                </p>
                <p class="mt-2 font-mono text-sm text-gray-600">
                  Figma, Research, Prototyping
                </p>
              </div>
            </div>
          </aside>

          <!-- MAIN CONTENT -->
          <div class="px-6 sm:px-10 lg:px-14 py-10 lg:py-14">
            <!-- HERO IMAGE -->
            <section class="mb-16">
              <div class="group rounded-3xl border border-gray-200 bg-gray-50 p-5 sm:p-8 transition-all duration-300 hover:bg-white hover:shadow-xl hover:-translate-y-1">
                <img
                  src="/images/propel/hero.png"
                  alt="Propel app redesign screens"
                  data-expandable
                  data-src="/images/propel/hero.png"
                  data-alt="Propel app redesign screens"
                  class="mx-auto w-full max-w-2xl rounded-2xl border border-gray-200 transition-transform duration-300 group-hover:scale-[1.01] cursor-zoom-in"
                />
              </div>
            </section>

            <!-- OVERVIEW -->
            <section id="overview" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>01</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Overview
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 space-y-6">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  Propel helps users manage benefits-related information, including EBT balance tracking and support resources.
                  For this redesign, I focused on connecting benefits, grocery inventory, and budgeting so users could make clearer
                  decisions around food and spending.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {[
                    ["Role", "UX Designer"],
                    ["Focus", "Benefits + grocery planning"],
                    ["Output", "High-fidelity prototype"],
                  ].map(([label, value]) => (
                    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                      <p class="font-mono text-xs uppercase tracking-widest text-gray-400">
                        {label}
                      </p>
                      <p class="mt-2 font-bold text-gray-950">
                        {value}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <!-- PROBLEM -->
            <section id="problem" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>02</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Problem
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 space-y-6">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  People who rely on EBT benefits often need to make careful decisions around grocery spending, food inventory,
                  and upcoming deposits. However, checking a balance alone does not always help users understand what they already
                  have at home, what food may expire soon, or how to plan purchases around their remaining benefits.
                </p>

                <div class="rounded-3xl bg-gray-950 p-6 sm:p-8 text-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                  <p class="text-2xl sm:text-3xl font-bold leading-snug">
                    How might we help Propel users connect their benefits, grocery inventory, and spending habits so they can make more informed food and budgeting decisions?
                  </p>
                </div>
              </div>
            </section>

            <!-- RESEARCH -->
            <section id="research" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>03</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Research
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 rounded-3xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  Our research showed that users need more than a balance number. They need to understand what food they already have,
                  what may expire soon, when their next deposit is coming, and how their spending affects future grocery decisions.
                </p>
              </div>
            </section>

            <!-- INSIGHTS -->
            <section id="insights" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>04</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Insights
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
                {insights.map(([title, text], index) => (
                  <div class="group rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <p class="font-mono text-xs uppercase tracking-widest" style={`color: ${accent}`}>
                      Insight 0{index + 1}
                    </p>

                    <h3 class="mt-4 text-xl font-bold group-hover:translate-x-1 transition-transform duration-300">
                      {title}
                    </h3>

                    <p class="mt-3 font-mono text-sm leading-relaxed text-gray-600">
                      {text}
                    </p>
                  </div>
                ))}
              </div>
            </section>

            <!-- USER FLOWS -->
            <section id="flows" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>05</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                User Flows
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 space-y-6">
                {userFlows.map(([src, caption]) => (
                  <figure class="group rounded-3xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 overflow-hidden">
                      <img
                        src={src}
                        alt={caption}
                        data-expandable
                        data-src={src}
                        data-alt={caption}
                        class="mx-auto w-full max-w-xl max-h-[260px] object-contain rounded-xl transition-transform duration-300 group-hover:scale-[1.02] cursor-zoom-in"
                      />
                    </div>

                    <figcaption class="mt-4 font-mono text-sm leading-relaxed text-gray-600">
                      {caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>

            <!-- FINAL PROTOTYPE -->
            <section id="prototype" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>06</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Prototype
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  The final prototype focuses on four key screens that connect benefits tracking,
                  spending visibility, receipt review, and grocery inventory management.
                </p>

                <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
                  {prototypeScreens.map(([src, alt, caption]) => (
                    <figure
                      class="group rounded-3xl border border-gray-200 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl cursor-zoom-in"
                      data-expandable
                      data-src={src}
                      data-alt={alt}
                    >
                      <div class="relative bg-transparent p-0 overflow-hidden min-h-[420px] flex items-center justify-center">
                        <img
                          src={src}
                          alt={alt}
                          class="mx-auto h-[360px] w-auto object-contain transition-transform duration-300 group-hover:scale-105 pointer-events-none"
                        />

                        <div class="absolute inset-0 bg-gray-950/0 transition group-hover:bg-gray-950/[0.03]"></div>
                      </div>

                      <figcaption class="mt-4 font-mono text-sm leading-relaxed text-gray-600">
                        {caption}
                      </figcaption>

                      <p
                        class="mt-3 font-mono text-xs opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0"
                        style={`color: ${accent}`}
                      >
                        View screen
                      </p>
                    </figure>
                  ))}
                </div>
              </div>
            </section>

            <!-- USER TESTING RESULTS -->
            <section id="testing" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>07</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Testing Results
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  After creating our initial redesign, we reviewed the screens through a user-testing lens to see whether the experience clearly supported grocery planning, benefit tracking, and spending decisions.
                </p>

                <p class="mt-6 max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  The biggest takeaway was that users needed clearer reminders, more actionable inventory updates, and spending breakdowns that were easier to interpret at a glance.
                </p>

                <div class="mt-8 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                  <img
                    src="/images/propel/user-testing-overview.png"
                    alt="Propel redesign overview with problem statement and inventory screen"
                    data-expandable
                    data-src="/images/propel/user-testing-overview.png"
                    data-alt="Propel redesign overview with problem statement and inventory screen"
                    class="w-full rounded-2xl border border-gray-200 cursor-zoom-in"
                  />
                  <p class="mt-4 font-mono text-sm leading-relaxed text-gray-600">
                    We focused the redesign around helping EBT users track groceries, pace spending, and reduce the mental effort of remembering what food they already have.
                  </p>
                </div>

                <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5">
                  {findings.map(([title, text], index) => (
                    <div class="group rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                      <p class="font-mono text-xs uppercase tracking-widest" style={`color: ${accent}`}>
                        Finding 0{index + 1}
                      </p>

                      <h3 class="mt-4 text-xl font-bold group-hover:translate-x-1 transition-transform duration-300">
                        {title}
                      </h3>

                      <p class="mt-3 font-mono text-sm leading-relaxed text-gray-600">
                        {text}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <!-- BEFORE AND AFTER STORIES -->
            <section id="before-after" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>08</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Before & After
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 space-y-8">
                {beforeAfterStories.map(([src, alt, title, text], index) => (
                  <article class="group rounded-3xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <img
                      src={src}
                      alt={alt}
                      data-expandable
                      data-src={src}
                      data-alt={alt}
                      class="w-full rounded-2xl border border-gray-200 cursor-zoom-in transition-transform duration-300 group-hover:scale-[1.01]"
                    />

                    <div class="mt-6 max-w-4xl">
                      <p class="font-mono text-xs uppercase tracking-widest" style={`color: ${accent}`}>
                        Story 0{index + 1}
                      </p>

                      <h3 class="mt-3 text-2xl font-bold text-gray-950">
                        {title}
                      </h3>

                      <p class="mt-3 font-mono text-sm sm:text-base leading-relaxed text-gray-600">
                        {text}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <!-- REFLECTION -->
            <section id="reflection" class="scroll-mt-28 border-t border-gray-200 py-14">
              <p class="font-mono text-sm" style={`color: ${accent}`}>09</p>
              <h2 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight">
                Reflection
              </h2>
              <div
                class="w-[75px] h-[5px] mt-4 rounded-full"
                style={`background-color: ${accent}`}
              />

              <div class="mt-10 rounded-3xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                <p class="max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  This project helped me think more intentionally about how product design can reduce cognitive load.
                  Benefits information can easily become overwhelming, so I focused on designing screens that help users
                  quickly understand what matters and what they can do next.
                </p>

                <p class="mt-6 max-w-4xl font-mono text-lg leading-relaxed text-gray-600">
                  If I continued this project, I would test the prototype with users to understand whether the dashboard,
                  grocery inventory, and budgeting tools feel clear and useful in real situations.
                </p>
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>

    <!-- IMAGE LIGHTBOX -->
    <div
      id="image-lightbox"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 px-6 py-8"
    >
      <button
        id="lightbox-close"
        class="absolute right-6 top-6 rounded-full bg-white px-4 py-2 font-mono text-sm text-gray-900 shadow-lg transition hover:bg-gray-100"
        aria-label="Close expanded image"
      >
        Close
      </button>

      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-h-[85vh] max-w-[90vw] object-contain shadow-2xl"
      />
    </div>

    <script>
      const expandableItems = document.querySelectorAll("[data-expandable]");
      const lightbox = document.getElementById("image-lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const closeButton = document.getElementById("lightbox-close");

      expandableItems.forEach((item) => {
        item.addEventListener("click", () => {
          if (!lightbox || !lightboxImage) return;

          const imageSource = item.getAttribute("data-src");
          const imageAlt = item.getAttribute("data-alt") || "";

          if (!imageSource) return;

          lightboxImage.setAttribute("src", imageSource);
          lightboxImage.setAttribute("alt", imageAlt);

          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          document.body.style.overflow = "hidden";
        });
      });

      const closeLightbox = () => {
        if (!lightbox || !lightboxImage) return;

        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightboxImage.setAttribute("src", "");
        document.body.style.overflow = "";
      };

      closeButton?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    </script>

    <Footer />
  </body>
</html>